# Data and artifacts are never committed; .gitkeep and the manifest are.
data/*
!data/.gitkeep
!data/manifest.json
artifacts/*
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.python-version.local

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp

# Local secrets / overrides
.env
.env.*

# Local assistant state
.claude/
PROMPT.md
